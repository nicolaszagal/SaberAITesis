# Build context = backend/, usado por fog/Dockerfile y cloud/Dockerfile
# (ambos dependen de shared/, que vive acá en la raíz — ver
# docker-compose.yml). edge/ se buildea con su propio contexto
# (edge/.dockerignore) y no pasa por acá.

.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

tests/
edge/
docs/
datos/
datos-humo/

.git/
.DS_Store

# Nunca hornear credenciales locales en una imagen.
.env
**/.env

*.md

# No hornear el Dockerfile de cada módulo dentro de su propia imagen
# (COPY fog/ fog/ y COPY cloud/ cloud/ lo incluirían si no).
fog/Dockerfile
cloud/Dockerfile
docker-compose*.yml
