# Configuración mínima de la Validación 1 con Docker Compose.
# Copiar a .env (cp .env.example .env). No subir .env al repositorio.

# Contraseña de PostgreSQL. CAMBIARLA si el equipo es compartido o accesible
# por red. Usar solo letras y números (se inserta en una URL).
POSTGRES_PASSWORD=sabre_local

# Puertos del host. Son los únicos que se publican. PostgreSQL y Redis no se
# publican. Cambiar si están ocupados.
FRONTEND_HOST_PORT=8081
FOG_HOST_PORT=8001

# Solo modo piloto (docker-compose.nativo.yml): puertos de PostgreSQL y Redis en
# 127.0.0.1 para el Fog nativo. Opcionales; cambiar si están ocupados.
# POSTGRES_HOST_PORT=5436
# REDIS_HOST_PORT=6380

# --- Autenticación y endurecimiento de Fog (DEPLOY05) ---
# Fog no arranca sin AUTH_USER, AUTH_PASSWORD_HASH y AUTH_JWT_SECRET. No poner
# valores reales en este archivo ni en git: se definen solo en el .env local.
AUTH_USER=
# Hash Argon2id del usuario maestro: python scripts/crear_hash_password.py --env
# imprime la línea completa. Va entre comillas simples porque el hash lleva "$".
AUTH_PASSWORD_HASH=''
# Al menos 32 bytes aleatorios, p. ej.: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=
# "remoto" desactiva /docs, /redoc, /openapi.json y /ws/veredicto. Vacío o "local" en el Mac.
ENTORNO=local
# Orígenes CORS separados por comas, sin comodines. Vacío en el despliegue remoto (mismo origen).
# En desarrollo: http://localhost:8081
CORS_ORIGINS=http://localhost:8081
# Solo despliegue remoto: el nginx del frontend lo envía en X-Proxy-Token. Vacío en local.
PROXY_SHARED_TOKEN=
