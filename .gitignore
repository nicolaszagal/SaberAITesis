# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
*.egg-info/

# macOS
.DS_Store

# Config local por módulo (fog/.env, cloud/.env, edge/.env) — nunca
# comitear, cada quien crea el suyo siguiendo GUIA_EJECUCION.md sección 3.
.env

# Excepción intencional: dataset/lstm_6class/checkpoints/<run_id>/
# (run_config.json + best_model.pt) SÍ se comitea porque Render solo ve lo
# que está en el repo de GitHub — ver GUIA_EJECUCION.md sección 6.2 y
# cloud/Dockerfile. Solo el run vigente, no toda la carpeta checkpoints/
# (las demás corridas del diagnóstico en curso no se despliegan).

# Datos de la Validación 1 en bind mounts (docker-compose.yml): clips,
# keypoints y evidencia. Se versionan solo los .gitkeep.
datos/*/*
!datos/*/.gitkeep
datos-humo/

# Excepción: plantilla de configuración del despliegue con Docker.
!.env.example

# Prueba remota (DEPLOY03): credenciales del proxy y estado del túnel.
.secrets/
datos/prueba_remota_*
